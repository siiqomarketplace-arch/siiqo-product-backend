# Alembic is NOT run automatically on deploy (Nov 2026). Production's migration
# version is unknown and an old revision (d1e2f3a4b5c6) deletes some admin users.
# The app creates missing tables and columns itself at startup. Run migrations
# by hand, once, following docs/MIGRATIONS_RUNBOOK.md.
container_commands:
  02_events_migration:
    command: "source /var/app/venv/*/bin/activate && python run_events_migration.py || true"
    leader_only: true
  03_slug_redirects_migration:
    command: "source /var/app/venv/*/bin/activate && python create_article_slug_redirects_migration.py || true"
    leader_only: true
  04_telemetry_migration:
    command: "source /var/app/venv/*/bin/activate && python apply_telemetry_migration.py || true"
    leader_only: true
