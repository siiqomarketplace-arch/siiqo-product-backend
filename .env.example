# ============================================================
# Siiqo Backend — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---- Security (REQUIRED in production) ----
SECRET_KEY=change-this-to-a-long-random-string
JWT_SECRET_KEY=change-this-to-another-long-random-string

# ---- Database ----
# SQLite (local dev — default if not set)
# DATABASE_URL=sqlite:///siiqo.db

# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@host:5432/siiqo_db

# ---- Flask ----
FLASK_ENV=development
# FLASK_ENV=production

# ---- CORS ----
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,https://siiqo.com,https://www.siiqo.com

# ---- Redis (for rate limiting in production) ----
# REDIS_URL=redis://localhost:6379/0
# REDIS_URL=rediss://user:password@host:6380/0  (TLS)

# ---- Email (cPanel SMTP) ----
MAIL_SERVER=mail.siiqo.com
MAIL_PORT=465
MAIL_USERNAME=support@siiqo.com
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=support@siiqo.com

# ---- PayScrow (Escrow Payment Gateway — physical products + payment links) ----
PAYSCROW_API_KEY=your-payscrow-api-key
PAYSCROW_WEBHOOK_SECRET=your-payscrow-webhook-secret

# ---- Paystack (Digital/service products + subscriptions) ----
PAYSTACK_SECRET_KEY=sk_live_your-paystack-secret-key
# Paystack plan codes for Pro subscriptions
PAYSTACK_MONTHLY_PLAN_CODE=PLN_xxxxxxxxxxxxxxx
PAYSTACK_ANNUAL_PLAN_CODE=PLN_yyyyyyyyyyyyyyy

# ---- Daya (Crypto payments for digital/service products) ----
# Get keys from https://dashboard.daya.co → API Keys
# Sandbox: sk_sandbox_...   Production: sk_live_...
DAYA_API_KEY=sk_sandbox_your-daya-api-key
# Set to "true" to force sandbox even with a live key (useful for staging)
DAYA_SANDBOX=false
# Webhook secret — copy from Daya dashboard → Webhooks after adding your endpoint
DAYA_WEBHOOK_SECRET=your-daya-webhook-secret
# Daya webhook endpoint to register in your Daya dashboard:
#   https://api.siiqo.com/api/payments/daya/webhook

# ---- AWS S3 (File Uploads — optional, falls back to local storage) ----
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_S3_BUCKET_NAME=siiqo-uploads
# AWS_REGION=us-east-1

# ---- Mapbox (Location features) ----
# MAPBOX_TOKEN=your-mapbox-token
